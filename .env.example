# Copy to .env and fill in. Keep .env private (chmod 600), it holds the bot token.

# --- Discord: https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Turn on Developer Mode (User Settings -> Advanced), then right-click -> "Copy ID"
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
# Who may create/delete servers and edit the whitelist: members with this role,
# and/or these user IDs (comma-separated). Set at least one of the two.
DISCORD_ADMIN_ROLE_ID=
DISCORD_ADMIN_USER_IDS=

# --- Minecraft
# Set to TRUE only after reading and accepting https://aka.ms/MinecraftEULA
MC_EULA=FALSE
# Shown in Discord so players know where to connect (e.g. your playit.gg address)
MC_PUBLIC_ADDRESS=
MC_LAN_ADDRESS=
# Java heap for the server, and the hard memory limit of its container (heap + about 700 MB)
MC_MEMORY=2560M
MC_MEM_LIMIT=3200m
# Stop automatically when nobody has been online for this long
MC_AUTOSTOP_MINUTES=15
MC_MAX_PLAYERS=10
# World backups kept per server (made after every stop)
MC_BACKUP_KEEP=5
# Text in the Minecraft server list, {name} becomes the server name
MC_MOTD=Minecraft · {name}
TZ=UTC
